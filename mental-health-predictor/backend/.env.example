# Copy to .env for local development. Never commit .env. Real values for staging/production go in the
# hosting provider's environment settings, not in files.
# The app refuses to start if a required value is missing or malformed.

# REQUIRED. One of: local, staging, production.
# production turns off /docs, requires MODEL_SHA256, forbids LOG_LEVEL=DEBUG and CORS '*', adds HSTS.
APP_ENV=local

# REQUIRED. Path to the trained pipeline exported from code.ipynb.
# For a smoke run without your real model: python -m scripts.make_dev_model  (writes a SYNTHETIC model)
MODEL_PATH=models/Mental_Health_Model2.pkl

# REQUIRED in production, optional elsewhere. SHA-256 of the model file; it is checked before loading.
# Linux/macOS: sha256sum models/Mental_Health_Model2.pkl     Windows: certutil -hashfile <file> SHA256
MODEL_SHA256=

# Comma-separated exact origins allowed to call the API from a browser (no trailing path).
# Leave empty if the frontend reaches the API through a same-origin proxy (the Vite dev server does).
# Example: https://your-frontend.example.com
CORS_ORIGINS=

# DEBUG, INFO, WARNING or ERROR. DEBUG is rejected in production.
LOG_LEVEL=INFO

# Requests per minute per client IP. In-memory and per instance (docs/decisions/0004).
RATE_LIMIT_PREDICT_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# true only when exactly one trusted reverse proxy sits in front of the app and sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
