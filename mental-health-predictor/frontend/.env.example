# Everything prefixed VITE_ is compiled into the public JavaScript bundle and visible to every visitor.
# Never put a secret, key or private URL here. This app has no secrets on the client by design.

# Base URL of the API, without a trailing slash.
# Leave empty in development: the Vite dev server proxies /api to http://localhost:8000.
# Set it when the frontend and API are on different domains, e.g. https://api.example.com
# (and add the frontend's origin to CORS_ORIGINS on the backend).
VITE_API_BASE_URL=
